# ---------------------------------------------------------------------------
# Copy to .env for local runs:  cp .env.example .env
# In the cloud (Railway / systemd / docker-compose) set these as real env vars.
# Only TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are required; everything else
# falls back to the defaults shown here.
# ---------------------------------------------------------------------------

# --- Telegram (REQUIRED) ---------------------------------------------------
# Token from @BotFather; chat id from @userinfobot (or a -100... group id).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=123456789
SEND_STARTUP_MESSAGE=true

# --- Market data -----------------------------------------------------------
# Any ccxt exchange id. Use binanceus / kucoin / okx if binance.com returns
# HTTP 451 from your host's region.
EXCHANGE_ID=binance
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,ADA/USDT,XRP/USDT,DOGE/USDT,MATIC/USDT,AVAX/USDT,LINK/USDT
TIMEFRAME=15m
CANDLE_LIMIT=300
FETCH_RETRIES=4
FETCH_BACKOFF_SECONDS=2

# --- Indicators ------------------------------------------------------------
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2.0
ATR_PERIOD=14
TREND_EMA_PERIOD=200
VOLUME_SMA_PERIOD=20
VOLUME_SPIKE_MULTIPLIER=1.5
# pandas (built-in, default) | pandas_ta (needs requirements-optional.txt) | auto
INDICATOR_BACKEND=auto

# --- Risk management -------------------------------------------------------
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=2.0
CAPITAL=1000
RISK_PERCENT=1
SHOW_POSITION_SIZE=true
# Adds plain-language "what to do" steps to every alert, and warns that a SELL
# cannot be taken on a spot account. Turn off once you no longer need them.
BEGINNER_MODE=true
# Exchange taker fee per side, used by outcome tracking and --backtest.
# Binance spot taker is 0.1%. On a tight 15m stop this is not a rounding error.
FEE_PERCENT=0.1

# --- Signal filtering ------------------------------------------------------
# rsi_reversal, macd_crossover, bb_breakout
ENABLED_SETUPS=rsi_reversal,macd_crossover,bb_breakout
# 1 = send everything, 2 = at least one confirmation, 3 = only the strongest
MIN_CONFIDENCE=1

# --- Scheduling & state ----------------------------------------------------
POLL_INTERVAL_MINUTES=15
CANDLE_CLOSE_BUFFER_SECONDS=15
STATE_FILE=signal_state.json
# Optional: touched after every scan cycle so a monitor can detect a wedged bot.
# Leave empty to disable. The Docker image sets this automatically.
HEARTBEAT_FILE=
SIGNAL_COOLDOWN_MINUTES=45
STATE_RETENTION_DAYS=7
# Follow every sent signal to its stop or target and report the result.
TRACK_OUTCOMES=true
TRACKER_FILE=signal_outcomes.json
# Candles per pair for `python main.py --backtest` (exchange max is usually 1000).
BACKTEST_CANDLES=1000
LOG_LEVEL=INFO

# --- Web dashboard (optional) ----------------------------------------------
# Run it with: python webserver.py   (serves on $PORT, default 8000)
# When true, the same process also runs the scanning loop, so one deployment
# gives you both the dashboard and Telegram alerts.
RUN_BOT_IN_WEBAPP=true
# Seconds a market snapshot is reused before refetching. Ten pairs on a 15m
# timeframe do not change meaningfully within a minute.
DASHBOARD_CACHE_SECONDS=45
# Strongly recommended once the dashboard has a public URL: it shows your
# trading record. With this set the page needs ?key=... to open.
DASHBOARD_TOKEN=

# --- MetaTrader 5 execution (optional, OFF by default) ----------------------
# This is the only part of the bot that can move money. Everything above is
# read-only. Two separate switches have to be on before a real order is sent.
#
# Windows only: pip install -r requirements-mt5.txt, with the MT5 terminal
# installed, logged in, and "Algo Trading" enabled in its toolbar.
#
# Switch 1: turn execution on at all.
MT5_ENABLED=false
# Switch 2: allow a LIVE account. Without this the bot refuses to trade any
# account the terminal does not report as a demo, so a misconfiguration costs
# you demo money. Turn it on only after watching the bot run on demo.
MT5_ALLOW_LIVE=false
# Compute and log orders without sending them. Useful on a live account.
MT5_DRY_RUN=false

# Leave all three blank to trade whatever account the terminal is already
# logged into. Set all three to log in explicitly (partial sets are rejected).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Only needed when terminal64.exe is not where MT5 installs it by default.
MT5_PATH=

# Brokers spell the same instrument differently. The bot guesses (BTC/USDT ->
# BTCUSDT, then BTCUSD), and you override what it gets wrong:
#   MT5_SYMBOL_MAP=BTC/USDT=BTCUSD,ETH/USDT=ETHUSD
# Run `python main.py --test-mt5` to see what each pair resolved to.
MT5_SYMBOL_MAP=
# Some brokers suffix every symbol (BTCUSD.r, BTCUSDm). Set it once here.
MT5_SYMBOL_SUFFIX=
# Tags this bot's orders so it only ever manages its own positions. Change it
# if you run two copies against one account.
MT5_MAGIC=907001
# Max price slippage tolerated, in points.
MT5_DEVIATION_POINTS=20
# FOK / IOC / RETURN. Blank = ask the symbol what it supports (do that).
MT5_FILLING_MODE=

# --- Execution risk limits ---
# Position size always comes from RISK_PERCENT and the signal's own stop
# distance, never a fixed lot. These cap what a bad run can do on top of that.
# Positions open at once. 0 = unlimited (not advised).
MT5_MAX_OPEN_POSITIONS=3
# Orders per UTC day. 0 = unlimited.
MT5_MAX_ORDERS_PER_DAY=10
# Hard ceiling on lot size regardless of what sizing asks for. 0 = broker's max.
MT5_MAX_LOT=0
# Only trade signals scoring at least this out of 3. Deliberately stricter than
# MIN_CONFIDENCE: a weak alert costs nothing to ignore, a weak trade costs a spread.
MT5_MIN_CONFIDENCE=2
# Broker fills, slippage and rejections. Separate from TRACKER_FILE, which
# scores the signals themselves.
MT5_EXECUTION_FILE=mt5_executions.json

# --- Trend Sniper setup ------------------------------------------------------
# Enable it by adding it to ENABLED_SETUPS:
#   ENABLED_SETUPS=rsi_reversal,macd_crossover,bb_breakout,trend_sniper
# It fires only when a Bollinger/Keltner squeeze releases, the EMA ribbon is
# stacked and open in that direction, ADX says the market is trending, and MACD
# and Stoch-RSI both agree the move has not already run.
STOCH_RSI_PERIOD=14
STOCH_RSI_K=3
STOCH_RSI_D=3
# Above/below these the move counts as already exhausted.
STOCH_RSI_OVERBOUGHT=80
STOCH_RSI_OVERSOLD=20
ADX_PERIOD=14
# ADX at or above this is "trending" — the sniper refuses anything below it.
ADX_TRENDING=25
ADX_BUILDING=20
# Keltner channels, the other half of the squeeze.
KC_PERIOD=20
KC_MULTIPLIER=1.5
RIBBON_LENGTHS=8,13,21,34,55
# How far the ribbon must be open, as a fraction of price, before a stack counts
# as a trend. Without a floor, flat noise lines up often enough to look like one.
RIBBON_MIN_WIDTH=0.002

# --- Scaled take-profits -----------------------------------------------------
# The Trend Sniper exits in four parts instead of one. Multipliers are in ATR;
# fractions are how much of the position each rung closes and are normalised to
# sum to 1. The two lists MUST be the same length or the ladder is ignored.
TP_ATR_MULTIPLIERS=1.0,2.0,3.0,4.0
TP_CLOSE_FRACTIONS=0.4,0.3,0.2,0.1
# Move the stop to break-even once this many rungs are in. 0 disables it.
BREAKEVEN_AFTER_TARGET=1
# Timeframes shown in the board's context panel.
CONTEXT_TIMEFRAMES=15m,1h,4h,1d
